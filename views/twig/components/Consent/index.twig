{% import 'components/UI/index.twig' as ui %}

<div id="component-consent" class="fixed bottom-0 left-0 hidden w-full border-t border-gray-200 bg-gray-100 py-16 text-small" data-mode="{{ get_field('cookies_mode', 'options') }}">
  <div class="container mx-auto px-10 py-2">
    {{ get_field('cookies_text', 'options') }}
    <div class="mt-16 flex justify-center gap-16">
      <button id="btn-consent-agree">Accepter</button>
      <button id="btn-consent-decline">Refuser</button>
      <button id="btn-consent-configure" command="show-modal" commandfor="component-consent-dialog">Configurer</button>
    </div>
  </div>
</div>

<el-dialog>
  <dialog id="component-consent-dialog" class="fixed inset-0 size-auto max-h-none max-w-none overflow-y-auto bg-transparent">
    <el-dialog-backdrop class="fixed inset-0 bg-gray-100 opacity-75"></el-dialog-backdrop>
    <div tabindex="0" class="flex min-h-full items-center justify-center">
      <el-dialog-panel class="relative m-16 w-full max-w-640 rounded-lg border border-gray-600 bg-gray-400 p-16 text-left text-white lg:px-32 lg:py-24">
        <p class="mb-24 font-headline text-base">Paramètres de confidentialité</p>
        <div class="flex flex-col gap-16">
          {% for setting in get_field('cookies_settings', 'options') %}
            <div class="flex text-small">
              <div>
                <p class="font-headline">{{ setting.title }}</p>
                {{ setting.text }}
                {% if setting.key == 'traffic' %}
                  <p class="component-do-not-track-message hidden">{{ __('Vous avez activé la fonctionnalité «Ne pas suivre» de votre navigateur. Nous ne pouvons donc pas vous proposer d’activer ce cookie.', 'hw') }}</p>
                {% endif %}
              </div>
              <div>
                <input class="component-consent-setting-switch" type="checkbox" role="switch" data-key="{{ setting.key }}" data-mandatory="{{ setting.mandatory ? 'true' : 'false' }}" {{ setting.mandatory ? 'checked disabled' : '' }} />
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="flex justify-end">
          {{ ui.button('Enregistrer', { classes: 'btn-consent-save', variant: 'primary', attributes: { command: 'close', commandfor: 'component-consent-dialog' } }) }}
        </div>
      </el-dialog-panel>
    </div>
  </dialog>
</el-dialog>
