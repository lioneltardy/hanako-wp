<div class="hw-theme-switcher">
  <button class="hw-theme-switcher__button" id="bd-theme" type="button" aria-expanded="false" data-hw-dropdown-toggle data-hw-dropdown-menu="#bd-theme-menu" aria-label="Toggle theme (auto)">
    <div class="bi theme-icon-active bi-color-theme-auto"></div>
  </button>
  <ul id="bd-theme-menu" class="hw-theme-switcher__menu" aria-label="Theme picker" hidden>
    <li>
      <button type="button" class="hw-theme-switcher__item" data-theme-value="light" data-hw-dropdown-close aria-pressed="false">
        <div class="bi bi-sm bi-color-theme-light"></div>
        Light
      </button>
    </li>
    <li>
      <button type="button" class="hw-theme-switcher__item" data-theme-value="dark" data-hw-dropdown-close aria-pressed="false">
        <div class="bi bi-sm bi-color-theme-dark"></div>
        Dark
      </button>
    </li>
    <li>
      <button type="button" class="hw-theme-switcher__item active" data-theme-value="auto" data-hw-dropdown-close aria-pressed="true">
        <div class="bi bi-sm bi-color-theme-auto"></div>
        Auto
      </button>
    </li>
  </ul>
</div>
