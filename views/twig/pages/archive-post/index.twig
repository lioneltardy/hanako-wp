{% extends 'structure/html.twig' %}

{% block content %}
  <div class="container">
    <div class="grid grid-cols-12 gap-6">
      {% for post in posts %}
        <div class="col-span-12 lg:col-span-3">
          <div class="rounded-xl border border-slate-200 bg-white p-4">
            <h5 class="mb-2 mt-0">{{ post.title }}</h5>
            <p class="mb-3">{{ post.post_excerpt }}</p>
            <a href="{{ post.link }}" class="inline-block rounded-md bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">Read more...</a>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}
