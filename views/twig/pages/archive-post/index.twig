{% extends 'structure/html.twig' %}

{% block content %}
  <main class="py-16 lg:py-32">
    <div class="container">
      <div class="grid-12">
        {% for post in posts %}
          <div class="col-span-12 lg:col-span-3">
            <div class="rounded-xl border border-gray-600 bg-gray-400 p-16">
              <h2 class="font-headline">{{ post.title }}</h2>
              <p>{{ post.post_excerpt }}</p>
              <a href="{{ post.link }}" class="text-white underline hover:text-primary">Lire la suite…</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </main>
{% endblock %}
