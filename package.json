{
  "name": "hanako-wp",
  "type": "module",
  "version": "2.0.0",
  "description": "A basic wordpress template based on Timber/Twig, TailwindCSS 4 ant Hanako TS.",
  "homepage": "https://github.com/harkle/hanako-wp",
  "bugs": {
    "url": "https://github.com/harkle/hanako-wp/issues"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node build-legacy-css.mjs",
    "clean": "rimraf dist",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20.0.0",
    "@zackad/prettier-plugin-twig": "^0.17.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.15",
    "prettier": "^3.9.6",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^5.0.1",
    "rollup-plugin-copy": "^3.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.1.6",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tailwindplus/elements": "^1.0.22",
    "hanako-ts": "^2.0.3"
  }
}
